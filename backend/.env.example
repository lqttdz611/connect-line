# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG đưa file .env lên git.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connect-line
PORT=3000
# Chuỗi bí mật ký chứng nhận qua màn của khách. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAME_SECRET=
# ALLOWED_ORIGINS=http://localhost:5500,https://tenmien.com
# COOKIE_SECURE=1
